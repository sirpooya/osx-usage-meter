<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Sandbox is OFF, deliberately.

	  CLI Account Sync reads the OAuth token that Claude Code itself stores in the
	  login keychain (service "Claude Code-credentials"). Inside the sandbox a
	  process can only reach keychain items in its own access group, so that read
	  fails with errSecItemNotFound no matter what else is granted. Turning the
	  sandbox off is the price of zero-setup login, and it is what every other
	  tracker that syncs the CLI account does too.

	  Consequence: no Mac App Store distribution. Shipping is Homebrew cask plus
	  Sparkle, so nothing is lost. The app still makes no network calls beyond
	  api.anthropic.com and claude.ai, and never writes the token anywhere.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	  OAuth 登录在本地起一个短时 NWListener（loopback）接收系统浏览器
	  重定向回来的授权码。App Sandbox 下监听传入连接需要此 entitlement，
	  否则 NWListener 会进入 .failed（权限拒绝）。见 CodexOAuth/OAuthCallbackServer。
	-->
	<key>com.apple.security.network.server</key>
	<true/>
	<!--
	  Sparkle 2.x under App Sandbox: lets the main app reach Sparkle's
	  Installer (-spki) and Status (-spks) XPC services bundled inside
	  the Sparkle framework. Without these the one-click install fails
	  under the sandbox. See https://sparkle-project.org/documentation/sandboxing/
	  (SUEnableDownloaderService is intentionally omitted — the app has
	  network.client, so Sparkle downloads in-process.)
	-->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
